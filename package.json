{
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chartjs": "^0.3.24",
    "commander": "^13.1.0",
    "cross-fetch": "^4.1.0",
    "date-fns": "^4.4.0",
    "jsdom": "^26.1.0",
    "kysely": "^0.28.11",
    "lodash": "^4.18.1",
    "next": "15.1.6",
    "ora-classic": "^5.4.2",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "sqlite3": "^5.1.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@svenskamodellen/components": "^1.10.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.27",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "jest": "^29.7.0",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true,
            "jsx": "react-jsx"
          }
        }
      ]
    }
  },
  "name": "@svenskamodellen/starter",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "scripts": {
    "build": "next build",
    "combine": "rm -f db.sqlite && tsx bin/diarium.ts combineDatabases ../arbetsmiljo-2020/db.sqlite ../arbetsmiljo-2021/db.sqlite ../arbetsmiljo-2022/db.sqlite ../arbetsmiljo-2023/db.sqlite ../arbetsmiljo-2024/db.sqlite ../arbetsmiljo-2025/db.sqlite ../arbetsmiljo-2026/db.sqlite --dst db.sqlite",
    "deploy": "npx gh-pages --nojekyll --no-history --branch gh-pages -d out --repo git@github.com:arbetsmiljo/arbetsmiljo.github.io.git",
    "dev": "next dev",
    "diarium": "tsx bin/diarium.ts",
    "lint": "next lint",
    "ship": "pnpm build && pnpm deploy",
    "start": "next start",
    "test": "jest"
  },
  "version": "0.1.0"
}
